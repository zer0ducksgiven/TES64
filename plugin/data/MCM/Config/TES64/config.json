        { "text": "Sound and people", "type": "header" },
        { "id": "bSounds:Mario", "text": "Mario's voice and sounds", "type": "toggle", "help": "From your Super Mario 64 ROM. Takes effect after restarting the game.", "valueOptions": { "sourceType": "ModSettingBool" } },
        { "id": "iVolume:Mario", "text": "Volume", "type": "slider", "valueOptions": { "min": 0, "max": 100, "step": 5, "formatString": "{0}%", "sourceType": "ModSettingInt" } },
