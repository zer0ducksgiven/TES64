{
  "modName": "TES64",
  "displayName": "TES64 - Mario",
  "minMcmVersion": 9,
  "pages": [
    {
      "pageDisplayName": "Mario",
      "content": [
        { "text": "Mario mode", "type": "header" },
        { "id": "iToggleKey:Controls", "text": "Toggle Mario mode", "type": "keymap", "help": "Switch between Mario and your Skyrim character.", "valueOptions": { "sourceType": "ModSettingKeyMap" } },
        { "id": "iAttackKey:Controls", "text": "Punch / kick / dive (B)", "type": "keymap", "help": "Mario's own attack button. Jump and crouch use Skyrim's Jump and Sneak. On an Xbox pad: A jump, Y punch, tap X dive, LB crouch.", "valueOptions": { "sourceType": "ModSettingKeyMap" } },
        { "text": "Mario", "type": "header" },
        { "id": "fScale:Mario", "text": "Size", "type": "slider", "help": "Skyrim units per SM64 unit. 0.48 makes Mario about 0.6x an NPC's height. Applies next time Mario mode turns on.", "valueOptions": { "min": 0.3, "max": 1.0, "step": 0.02, "formatString": "{2}", "sourceType": "ModSettingFloat" } },
        { "id": "fDamageMult:Mario", "text": "Attack damage", "type": "slider", "help": "Mario's punches, kicks and ground pounds on Skyrim's people and creatures.", "valueOptions": { "min": 0.25, "max": 5.0, "step": 0.25, "formatString": "{2}x", "sourceType": "ModSettingFloat" } },
        { "id": "fWeaponScale:Mario", "text": "Weapon size in Mario's hands", "type": "slider", "help": "1.0 is the weapon's real Skyrim size, so Mario lugs a sword nearly as big as he is.", "valueOptions": { "min": 0.4, "max": 2.0, "step": 0.05, "formatString": "{2}", "sourceType": "ModSettingFloat" } },
        { "id": "bBodyPose:Mario", "text": "Skyrim's body movement in attacks", "type": "toggle", "help": "Mario's torso and head follow Skyrim's swing, cast or block, not just his arms.", "valueOptions": { "sourceType": "ModSettingBool" } },
        { "text": "HUD", "type": "header" },
        { "id": "fScale:HUD", "text": "HUD size", "type": "slider", "help": "Mario's meters, counters and compass.", "valueOptions": { "min": 0.5, "max": 2.0, "step": 0.05, "formatString": "{2}x", "sourceType": "ModSettingFloat" } },
        { "id": "bHideCrosshair:HUD", "text": "Hide the crosshair with weapons away", "type": "toggle", "valueOptions": { "sourceType": "ModSettingBool" } },
        { "id": "bCompass:HUD", "text": "SM64-style compass", "type": "toggle", "help": "Replaces Skyrim's compass while you're Mario.", "valueOptions": { "sourceType": "ModSettingBool" } },
        { "id": "bSM64Fonts:HUD", "text": "SM64 font for Skyrim's text", "type": "toggle", "help": "Menus, dialogue, books and messages in the SM64 font. Takes effect after restarting the game.", "valueOptions": { "sourceType": "ModSettingBool" } },
        { "text": "Sound and people", "type": "header" },
        { "id": "bSounds:Mario", "text": "Mario's voice and sounds", "type": "toggle", "help": "From your Super Mario 64 ROM. Takes effect after restarting the game.", "valueOptions": { "sourceType": "ModSettingBool" } },
        { "id": "iVolume:Mario", "text": "Volume", "type": "slider", "valueOptions": { "min": 0, "max": 100, "step": 5, "formatString": "{0}%", "sourceType": "ModSettingInt" } },
        { "id": "bNPCReactions:Mario", "text": "People comment on the plumber", "type": "toggle", "valueOptions": { "sourceType": "ModSettingBool" } }
      ]
    }
  ]
}
