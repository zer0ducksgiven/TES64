        { "id": "iAttackKey:Controls", "text": "Punch / kick / dive (B)", "type": "keymap", "help": "Mario's own attack button. Jump and crouch use Skyrim's Jump and Sneak.", "valueOptions": { "sourceType": "ModSettingKeyMap" } },
        { "text": "Mario", "type": "header" },
